{
    //sets the trackers layout
    //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
    "tracker_default": {
        "type": "container",
        "background": "#000000",
        "content": {
            "type": "dock",
            "dropshadow": true,
            "content": [{
                    "type": "tabbed",
                    "tabs": [{
                            "title": "Halo MCC Games",
                            "content": {
                                "type": "dock",
								"content": [
								{
									"type": "container",
									"dock": "left",
									"content": {
                                        "type": "layout",
                                        "key": "shared_item_grid"
									}
								}, {
                                        "type": "map",
                                        "maps": ["Overview"]
                                    }
                                ]
                            }
                        }, {
                            "title": "Halo CE",
                            "content": {
                                "type": "left",
								"content": [
								{
									"type": "container",
									"dock": "bottom",
									"content": {
                                        "type": "layout",
                                        "key": "Halo_CE_Skulls"
									}
								}, {
                                        "type": "map",
                                        "maps": ["Halo CE"]
                                    }
                                ]
                            }
                        }, {
                            "title": "Halo Reach",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Halo Reach"
                                ]
                            }
                        }, {
                            "title": "Halo 2",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Halo 2"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    }
}
