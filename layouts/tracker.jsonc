{
    //sets the trackers layout
    //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
    "tracker_default": {
        "type": "container",
        "background": "#000000",
        "content": {
            "type": "dock",
            "dropshadow": true,
            "content": [{
                    "type": "dock",
                    "dock": "bottom",
                    "content": [{
                            "type": "container",
                            "dock": "bottom",
                            "margin": "0,0,0,0",
                            "content": {
                                "type": "layout",
                                "h_alignment": "stretch",
                                "v_alignment": "center",
                                "key": "shared_item_grid"
                            }
                        }
                    ]
                }, {
                    "type": "tabbed",
                    "tabs": [{
                            "title": "Halo MCC Games",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Overview"
                                ]
                            }
                        }, {
                            "title": "Halo CE",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Halo CE"
                                ]
                            }
                        }, {
                            "title": "Halo Reach",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Halo Reach"
                                ]
                            }
                        }, {
                            "title": "Halo 2",
                            "content": {
                                "type": "map",
                                "maps": [
                                    "Halo 2"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    }
}
