{
    // sets layouts for shadred items grids
    // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
    "Halo_CE_Skulls": {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
		"h_alignment": "stretch",
        "content": [{
                "type": "array",
                "orientation": "vertical",
                "margin": "0,0",
                "content": [{
                        "type": "group",
                        "header": "Scoring Skulls",
                        "content": {
                            "type": "itemgrid",
                            "item_size": "60, 60",
                            "item_margin": "0, 0",
                            "item_h_alignment": "center",
                            "item_v_alignment": "center",
                            "h_alignment": "left",
                            "rows": [
                                ["Skull_HCE_Anger", "Skull_HCE_Black_Eye", "Skull_HCE_Blind", "Skull_HCE_Catch", "Skull_HCE_Eye_Patch", "Skull_HCE_Famine"],
                                ["Skull_HCE_Fog", "Skull_HCE_Foreign", "Skull_HCE_Iron", "Skull_HCE_Mythic", "Skull_HCE_Recession", "Skull_HCE_That's_Just_Wrong"],
