                            "item_v_alignment": "center",
                            "h_alignment": "left",
                            "rows": [
                                ["Skull_HCE_Acrophobia", "Skull_HCE_Bandanna", "Skull_HCE_Boom", "Skull_HCE_Ghost", "Skull_HCE_Grunt_Birthday_Party", "Skull_HCE_Grunt_Funeral"],
                                ["Skull_HCE_Malfunction", "Skull_HCE_Piñata", "Skull_HCE_Sputnik"]
                            ]
                        }
                    }
                ]
            }
        ]
    }
}
